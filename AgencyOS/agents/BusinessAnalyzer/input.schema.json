{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/schemas/business-analyzer/input",
  "title": "BusinessAnalyzerInput",
  "type": "object",
  "description": "What BusinessAnalyzer receives: a qualified Lead plus research context.",
  "required": ["lead", "request"],
  "properties": {
    "lead": {
      "$ref": "https://agency.os/schemas/lead/lead",
      "description": "Validated Lead from LeadHunter"
    },
    "request": {
      "type": "object",
      "required": ["targetLocale", "languages"],
      "properties": {
        "targetLocale": { "type": "string", "minLength": 2 },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "minItems": 1
        },
        "currency": {
          "type": "object",
          "properties": {
            "code": { "type": "string", "minLength": 3 },
            "symbol": { "type": "string" },
            "position": { "type": "string", "enum": ["before", "after"] }
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["identity", "contact", "menu", "offers", "gallery", "reviews", "seo", "social", "media", "all"]
          },
          "default": ["all"]
        },
        "verifyOnly": { "type": "boolean", "default": false },
        "existing": {
          "type": "object",
          "description": "Previously produced Business doc to update/verify"
        }
      }
    }
  },
  "additionalProperties": false
}
