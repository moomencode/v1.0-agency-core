{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agencyos:dossier/business",
  "title": "Dossier — Business Profile",
  "type": "object",
  "required": ["schemaId", "dossierId", "businessId", "documentId", "version", "createdAt", "name", "category", "scores"],
  "properties": {
    "schemaId": { "type": "string" },
    "dossierId": { "type": "string" },
    "businessId": { "type": "string" },
    "documentId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "subCategory": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "businessType": { "type": ["string", "null"] },
    "branchCount": { "type": "integer", "minimum": 1 },
    "location": { "type": "object" },
    "workingHours": { "type": ["array", "null"] },
    "phones": { "type": "array" },
    "emails": { "type": "array" },
    "whatsapp": { "type": ["string", "null"] },
    "reservationMethods": { "type": "array" },
    "orderingMethods": { "type": "array" },
    "digitalStatus": { "type": "string" },
    "scores": { "type": "object" },
    "verdict": { "type": ["string", "null"] },
    "strategy": { "type": ["string", "null"] },
    "priority": { "type": ["object", "null"] }
  }
}
