{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/delivery/request",
  "title": "DeliveryRequest",
  "description": "External contract for requesting a deployment through the delivery system.",
  "type": "object",
  "required": ["buildId", "mode", "provider", "target"],
  "properties": {
    "buildId": { "type": "string", "minLength": 16, "pattern": "^[0-9a-f]{16}$" },
    "mode": { "type": "string", "enum": ["dry-run", "explicit", "auto"] },
    "provider": { "type": "string", "minLength": 1 },
    "target": { "type": "object" },
    "trace": {
      "type": "object",
      "properties": {
        "dossierVersion": { "type": ["integer", "null"] },
        "pipelineRunId": { "type": ["string", "null"] }
      }
    },
    "rollbackOf": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
