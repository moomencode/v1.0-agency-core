{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/delivery/rollback-record",
  "title": "RollbackRecord",
  "description": "Sidecar document produced when a deployment is rolled back to a previous immutable package.",
  "type": "object",
  "required": ["schema", "recordId", "businessId", "previousBuildId", "mode", "by", "at"],
  "properties": {
    "schema": { "const": "https://agency.os/delivery/rollback-record" },
    "recordId": { "type": "string", "pattern": "^dep_[0-9a-f]{16}$" },
    "businessId": { "type": "string", "minLength": 1 },
    "previousBuildId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "mode": { "type": "string", "enum": ["dry-run", "explicit", "auto"] },
    "by": { "type": "string", "minLength": 1 },
    "note": { "type": ["string", "null"] },
    "url": { "type": ["string", "null"] },
    "at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
