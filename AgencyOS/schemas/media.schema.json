{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/schemas/media",
  "title": "Media",
  "type": "object",
  "description": "Canonical Media inventory + asset mapping. Produced by BusinessAnalyzer, materialized by Deployment.",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "sourceUrl"],
        "properties": {
          "assetId": { "type": "string" },
          "kind": { "type": "string", "enum": ["photo", "video", "logo", "favicon", "og-image"] },
          "sourceUrl": { "type": "string", "format": "uri" },
          "subject": { "type": "string", "description": "e.g. interior, dish-x, exterior" },
          "quality": { "type": "string", "enum": ["high", "medium", "low"] },
          "license": { "type": "string", "description": "verified license/usage right" },
          "isPlaceholder": { "type": "boolean" },
          "mappedPath": { "type": "string", "description": "businesses/<id>/assets/... target" },
          "usage": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["hero", "gallery", "menu-item", "about", "og-image", "logo", "favicon", "booking"]
            }
          }
        }
      }
    },
    "missingNeeded": {
      "type": "array",
      "items": { "type": "string", "description": "usages with no source found — placeholder required" }
    }
  },
  "additionalProperties": false
}
