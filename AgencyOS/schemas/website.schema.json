{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/schemas/website",
  "title": "Website",
  "type": "object",
  "description": "Canonical Website document: full engine config bundle + asset manifest. Produced by WebsiteBuilder.",
  "required": [
    "websiteId", "businessId", "engineVersion", "engineRoot",
    "config", "assetManifest", "buildParams"
  ],
  "properties": {
    "websiteId": { "type": "string" },
    "businessId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "engineVersion": { "type": "string", "description": "Pinned Website Engine version" },
    "engineRoot": { "type": "string", "description": "Path to engine (Garcia2)" },
    "config": {
      "type": "object",
      "description": "19 engine config keys (files), mirroring the engine contract",
      "required": [
        "business", "brand", "theme", "seo", "social", "contact", "navigation",
        "hero", "menu", "offers", "gallery", "booking", "features", "services",
        "stats", "reviews", "faq", "footer", "i18n", "order"
      ],
      "additionalProperties": false
    },
    "assetManifest": {
      "type": "array",
      "description": "Files the engine needs outside config",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string", "description": "Relative to businesses/<id>/assets" },
          "kind": { "type": "string", "enum": ["image", "logo", "video", "favicon", "og-image"] },
          "sourceUrl": { "type": "string", "format": "uri" },
          "isPlaceholder": { "type": "boolean" },
          "status": { "type": "string", "enum": ["pending", "ready", "missing"] }
        }
      }
    },
    "buildParams": {
      "type": "object",
      "description": "Parameterization passed to the engine build script",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["navbar", "hero", "menu", "offers", "reservation", "gallery", "location", "footer", "about", "services", "stats", "testimonials", "faq", "orderOnline"]
          }
        },
        "locale": { "type": "string", "description": "Default locale" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "phoneDigits": { "type": "string", "pattern": "^[+0-9 ]+$" },
        "businessType": { "type": "string" }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Blocking issues found during assembly",
      "items": {
        "type": "object",
        "properties": {
          "configKey": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "description": "Non-blocking quality notes",
      "items": { "type": "string" }
    },
    "status": { "type": "string", "enum": ["ready", "conflicted"] }
  },
  "additionalProperties": false
}
