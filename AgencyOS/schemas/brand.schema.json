{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/schemas/brand",
  "title": "Brand",
  "type": "object",
  "description": "Canonical Brand document. Maps to the engine brand.json + theme.json config keys.",
  "required": ["name", "tagline", "description"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string" },
    "description": { "type": "string" },
    "foundedYear": { "type": "integer" },
    "logoSrc": { "type": "string", "description": "asset path or source URL" },
    "brandColors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Brand color hex list — source of truth for palette derivation"
    },
    "palette": {
      "type": "object",
      "description": "Engine theme palettes (light/dark) with 10 RGB-triplet tokens",
      "properties": {
        "light": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^\\d+ \\d+ \\d+$" } },
        "dark": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^\\d+ \\d+ \\d+$" } }
      }
    },
    "voice": {
      "type": "object",
      "description": "Tone guidance for ContentWriter",
      "properties": {
        "tone": { "type": "string", "enum": ["friendly", "professional", "luxury", "energetic", "minimal", "warm"] },
        "audience": { "type": "string" },
        "do": { "type": "array", "items": { "type": "string" } },
        "dont": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}
