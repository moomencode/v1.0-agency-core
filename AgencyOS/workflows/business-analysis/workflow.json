{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/workflows/business-analysis",
  "title": "BusinessAnalysisWorkflow",
  "type": "object",
  "description": "Business dossier construction workflow definition.",
  "required": ["id", "name", "trigger", "actors", "steps", "exitConditions"],
  "properties": {
    "id": { "const": "business-analysis" },
    "name": { "const": "Business Analysis" },
    "trigger": {
      "type": "string",
      "description": "Qualified Lead persisted in CRM"
    },
    "actors": {
      "type": "array",
      "const": ["business-analyzer", "crm", "ops"]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "actor", "action", "output", "gate"],
        "properties": {
          "id": { "type": "string" },
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "output": { "type": "string" },
          "gate": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "condition": { "type": "string" }
            }
          }
        }
      },
      "minItems": 1
    },
    "exitConditions": {
      "type": "object",
      "properties": {
        "success": { "type": "string" },
        "fail": { "type": "string" }
      }
    },
    "entryDocument": { "type": "string" },
    "exitDocument": { "type": "string" }
  },
  "additionalProperties": false
}
