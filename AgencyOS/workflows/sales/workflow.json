{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/workflows/sales",
  "title": "SalesWorkflow",
  "type": "object",
  "description": "Proposal composition workflow definition.",
  "required": ["id", "name", "trigger", "actors", "steps", "exitConditions"],
  "properties": {
    "id": { "const": "sales" },
    "name": { "const": "Sales" },
    "trigger": {
      "type": "string",
      "description": "Approved Review emitted by QA workflow"
    },
    "actors": {
      "type": "array",
      "const": ["sales", "qa", "crm", "ops"]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "actor", "action", "output", "gate"],
        "properties": {
          "id": { "type": "string" },
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "output": { "type": "string" },
          "gate": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "condition": { "type": "string" }
            }
          }
        }
      },
      "minItems": 1
    },
    "exitConditions": {
      "type": "object",
      "properties": {
        "success": { "type": "string" },
        "fail": { "type": "string" }
      }
    },
    "entryDocument": { "type": "string" },
    "exitDocument": { "type": "string" }
  },
  "additionalProperties": false
}
