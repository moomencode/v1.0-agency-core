{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/orchestrator/campaign",
  "title": "Orchestrator Campaign",
  "type": "object",
  "required": ["name", "discovery"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "discovery": { "type": "object", "additionalProperties": true },
    "filters": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "minOpportunityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maxBusinesses": { "type": "integer", "minimum": 1 },
        "requireNoWebsiteOrWeak": { "type": "boolean" }
      }
    },
    "autonomyLevel": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "deployment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": { "type": "string" },
        "target": { "type": "object" },
        "allowedProviders": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "maxBusinesses": { "type": "integer", "minimum": 1 },
        "maxConcurrent": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "maxDeployments": { "type": "integer", "minimum": 0 },
        "maxAiCalls": { "type": "integer", "minimum": 0 },
        "maxProviderCalls": { "type": "integer", "minimum": 0 },
        "maxExecutionDurationMs": { "type": "integer", "minimum": 1 },
        "maxCampaignDurationMs": { "type": "integer", "minimum": 1 }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requireDeploymentApproval": { "type": "boolean" },
        "requireEscalationApproval": { "type": "boolean" },
        "autoApproveQaOverrides": { "type": "boolean" }
      }
    }
  }
}
