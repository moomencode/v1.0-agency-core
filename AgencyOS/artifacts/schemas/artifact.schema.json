{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency.os/artifacts/artifact",
  "title": "ArtifactRecord",
  "description": "Canonical metadata record for every generated artifact. Persisted as a sidecar ({file}.meta.json) next to the artifact and mirrored in the artifact index.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "slug",
    "type",
    "format",
    "extension",
    "mime",
    "version",
    "checksum",
    "sizeBytes",
    "createdAt",
    "projectId",
    "workflowId",
    "runId",
    "filename",
    "relativePath"
  ],
  "properties": {
    "schema": { "const": "https://agency.os/artifacts/artifact" },
    "id": { "type": "string", "minLength": 8 },
    "name": { "type": "string", "minLength": 1, "description": "Human name of the artifact" },
    "slug": { "type": "string", "minLength": 1, "description": "Filesystem-safe key derived from the name" },
    "type": {
      "type": "string",
      "description": "Artifact taxonomy: research-report, seo-report, brand-document, ux-audit, sales-proposal, contract, website-config, website, review, report, document, image, other",
      "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"
    },
    "format": { "type": "string", "enum": ["markdown", "json", "html", "text", "pdf", "image", "svg"] },
    "extension": { "type": "string" },
    "mime": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "checksum": { "type": "string", "minLength": 32, "description": "sha256 hex of the artifact bytes" },
    "sizeBytes": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "accessedAt": { "type": ["string", "null"], "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "projectId": { "type": "string" },
    "workflowId": { "type": "string" },
    "runId": { "type": ["string", "null"] },
    "stepId": { "type": ["string", "null"] },
    "sourceDocument": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "generatedBy": { "type": ["string", "null"] },
    "filename": { "type": "string" },
    "relativePath": { "type": "string", "description": "Path relative to the artifact engine root" },
    "metadata": { "description": "Free-form extension metadata" }
  },
  "additionalProperties": false
}
